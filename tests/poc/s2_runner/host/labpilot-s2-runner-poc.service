[Unit]
Description=LabPilot Slice 2 Candidate B PoC Runner
After=systemd-journald.socket

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/labpilot-s2-runner-poc
ExecStartPre=/usr/bin/install -d -o root -g labpilot-control -m 0750 /run/labpilot-s2-runner-poc
ExecStart=/usr/bin/python3 -E -s -m tests.poc.s2_runner.runner_daemon --policy /etc/labpilot-s2-runner-poc/policy.json --test-only-fault-injection
Restart=on-failure
RestartSec=1s
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX
UMask=0077

[Install]
WantedBy=multi-user.target
