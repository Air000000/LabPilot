[Unit]
Description=LabPilot Task12 native acceptance supervisor (%i)
After=docker.service
Requires=docker.service

[Service]
Type=exec
User=root
WorkingDirectory=/home/air/labpilot-slice3-native-repo
ExecStart=/usr/bin/python3 -B tests/acceptance/slice3/native_supervisor.py --invocation-id %i --evidence-root /home/air/labpilot-task12-native-evidence --product-candidate-sha __PRODUCT_CANDIDATE_SHA__ --acceptance-harness-sha __ACCEPTANCE_HARNESS_SHA__ --config-path __CONFIG_PATH__ --fixture-path __FIXTURE_PATH__ --systemd-unit-identity labpilot-task12-native-supervisor@%i.service --child-command-file /run/labpilot-task12-native/%i.json
