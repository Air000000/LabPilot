[Unit]
Description=LabPilot Candidate B Runner
After=local-fs.target

[Service]
Type=simple
User=root
Group=labpilot-control
UMask=0077
RuntimeDirectory=labpilot-runner
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=restart
ExecStart=/opt/labpilot-runner/app/.venv/bin/python -E -s -B -m labpilot.execution.runner_daemon --policy /etc/labpilot/runner-policy.json
Restart=on-failure
RestartSec=1s
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
