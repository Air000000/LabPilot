LABPILOT_ENVIRONMENT=development
LABPILOT_DATABASE_URL=postgresql+asyncpg://labpilot:labpilot@postgres:5432/labpilot
LABPILOT_LOG_LEVEL=INFO
LABPILOT_DATA_EGRESS_POLICY=local_only
LABPILOT_AGENT_PROVIDER_MODEL=
LABPILOT_AGENT_PROVIDER_API_KEY=
LABPILOT_INSTALLATION_IDENTITY=local-development
LABPILOT_LOCAL_ACTOR_ID=local-user
LABPILOT_REPOSITORY_ALLOWED_ROOTS=["/repositories"]
LABPILOT_REPOSITORY_CONTENT_STORE_ROOT=/var/lib/labpilot/content
LABPILOT_ATTEMPT_WORKSPACE_ROOT=/var/lib/labpilot/attempts
LABPILOT_RUNNER_SOCKET_PATH=/run/labpilot-runner/control.sock
LABPILOT_RUNNER_REQUEST_TIMEOUT_SECONDS=10
LABPILOT_UNKNOWN_ATTENTION_GRACE_SECONDS=60
LABPILOT_CONTROLLER_UID=1000
LABPILOT_CONTROLLER_GID=1000
LABPILOT_TRAIN_GID=1001
